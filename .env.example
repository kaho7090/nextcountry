# Travelport TripServices（トライアル / プレプロダクション）
TRAVELPORT_CLIENT_ID=your_client_id
TRAVELPORT_CLIENT_SECRET=your_client_secret
TRAVELPORT_USERNAME=your_username
TRAVELPORT_PASSWORD=your_password
TRAVELPORT_PCC=your_pcc

# 任意: アクセスグループ（未設定時は TVP-PCC-Core: {PCC}_1G ヘッダを使用）
# TRAVELPORT_ACCESS_GROUP=your-access-group-uuid
# TRAVELPORT_GDS_SUFFIX=1G

# 任意: エンドポイント（デフォルトはプレプロダクション）
# TRAVELPORT_AUTH_URL=https://auth.pp.travelport.net/oauth/token
# TRAVELPORT_API_BASE_URL=https://api.pp.travelport.net/11/air
